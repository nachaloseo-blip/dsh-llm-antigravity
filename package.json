{
  "name": "@local/dsh-llm-antigravity",
  "version": "1.3.2",
  "private": true,
  "description": "Google Antigravity (Cloud Code Assist) model provider for DeepSeek Harness, authenticated with a Google Antigravity subscription instead of a metered API key.",
  "license": "MIT",
  "author": "Artyom",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "antigravity",
    "gemini",
    "claude",
    "llm-provider"
  ],
  "type": "module",
  "main": "runtime.js",
  "exports": {
    ".": "./runtime.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "runtime.js",
    "client.js",
    "login.mjs",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
